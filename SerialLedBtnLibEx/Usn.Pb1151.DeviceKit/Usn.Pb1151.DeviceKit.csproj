<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Usn.Pb1151.DeviceKit</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <!-- NuGet package metadata -->
    <PackageId>Usn.Pb1151.DeviceKit</PackageId>
    <Version>1.0.1</Version>
    <Authors>Rune Langøy</Authors>
    <Company>University of South-Eastern Norway (USN)</Company>
    <Description>I/O library for the PB1151 course microcontroller kit: control LEDs and a servo, read pushbuttons, and read a TMP102 temperature sensor and an ADXL345 accelerometer over a JSON serial protocol, via USB serial or Bluetooth LE (Nordic UART Service).</Description>
    <PackageTags>usn;pb1151;serial;ble;bluetooth;microcontroller;iot;education</PackageTags>
    <RepositoryUrl>https://github.com/rlangoy/PB1151vSnippets</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright © 2026 Rune Langøy</Copyright>
    <PackageReleaseNotes>1.0.1: Lowered the minimum target Windows version from 10.0.19041.0 to 10.0.17763.0 (Windows 10, version 1809) to relax consuming-project TargetFramework requirements; no API changes. 1.0.0: Initial release. JsonSerialController with LedControl, ServoControl, ButtonControl, and SensorControl (TMP102 temperature, ADXL345 acceleration). Two transports: SerialPortEx (USB serial) and BleNusEx (BLE Nordic UART Service), both behind ISerialDataReadWrite.</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
